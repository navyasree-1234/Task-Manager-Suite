# Environment Variables Configuration
# Copy this file to .env or configure in your environment

# API Server Port (Default: 5000)
PORT=5000

# Database URL (Optional: defaults to embedded PGlite file database at .data/pglite_data)
# Example PostgreSQL: postgres://username:password@localhost:5432/task_manager_db
DATABASE_URL=

# JWT Secret for Auth signing
JWT_SECRET=task-manager-suite-secret-key-2026

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Frontend Dev Server Port (Default: 3000)
VITE_PORT=3000
